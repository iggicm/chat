{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "preserve",
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "strict": false
  },
  "angularCompilerOptions": {
    "strictTemplates": false
  }
}
